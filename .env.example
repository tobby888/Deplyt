DEPLOY_LISTEN_ADDR=127.0.0.1:8080
DEPLOY_TOKEN=
PRODUCTION_SSH_HOST=
PRODUCTION_SSH_PORT=22
PRODUCTION_SSH_USER=root
PRODUCTION_SSH_PASSWORD=''
PRODUCTION_SSH_HOST_KEY=''

# The same private bucket as PhotoLib, with transfer acceleration enabled.
OSS_BUCKET=
OSS_REGION=
# Optional regional HTTPS endpoint reachable from the production host.
# Example: https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_PRODUCTION_ENDPOINT=
OSS_ACCESS_KEY_ID=''
OSS_ACCESS_KEY_SECRET=''
OSS_ECS_RAM_ROLE=

# Optional fixed build artifact from a presigned URL or Bearer-authenticated endpoint.
OSS_ARTIFACT_URL=''
OSS_ARTIFACT_NAME=
OSS_ARTIFACT_SHA256=
OSS_ACCESS_TOKEN=''

DEPLYT_PUBLIC_URL=https://deploy.example.com
PHOTOLIB_PUBLIC_URL=https://photolib.example.com
DEPLYT_SSO_SECRET=''
# PhotoLib user ID for the Deplyt administrator.
DEPLOY_ADMIN_PHOTOLIB_ID=
# Optional. Copy the single-quoted setting from deplyt generate-emergency-password.
DEPLOY_EMERGENCY_PASSWORD_HASH=''

# Optional. systemd defaults to /var/lib/deplyt.
DEPLOY_STATE_DIR=

# GitHub fine-grained PAT for tobby888/Photolib; read-only.
GITHUB_TOKEN=''
# Separate fine-grained PAT for workflow dispatch (Actions: write).
GITHUB_ACTIONS_TOKEN=''
